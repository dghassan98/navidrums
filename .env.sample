PORT=8080
DB_PATH=/data/navidrums.db
DOWNLOADS_DIR=/music
PROVIDER_URL=https://hifi-api.com # change to your hifi-api url
QUALITY=LOSSLESS
LOG_LEVEL=info
LOG_FORMAT=text
NAVIDRUMS_USERNAME=navidrums
NAVIDRUMS_PASSWORD=admin
# Separate password for the Settings page. Leave unset to leave Settings open.
# NAVIDRUMS_ADMIN_PASSWORD=
# NAVIDRUMS_ADMIN_SESSION_TTL=30m
SUBDIR_TEMPLATE={{.AlbumArtist}}/{{.OriginalYear}} - {{.Album}}/{{.Disc}}-{{.Track}} {{.Title}}
# Qobuz Direct (optional) - use your own Qobuz subscription instead of a public proxy.
# app_id/app_secret are read from the Qobuz web player bundle; see QOBUZ_API.md.
# Each value is the WHOLE line: a trailing '# comment' becomes part of the value.
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=
# Identify the account EITHER with a token from a logged-in web player:
# QOBUZ_AUTH_TOKEN=
# ...OR with email + password:
# QOBUZ_EMAIL=
# QOBUZ_PASSWORD=
# QOBUZ_PASSWORD_MD5=
# Notifications (optional): Discord webhook URL, or an Apprise API endpoint.
# Also settable in Settings, which overrides this. Treat it as a password.
# NOTIFY_URL=
CACHE_TTL=12h
MUSICBRAINZ_URL=https://musicbrainz.org/ws/2
THEME=golden
